# UBO.Common — environment variables
# Copy the UBO_* variables into the .env of the application that installs the package.

# ----------------------------------------------------------------------------
# Modules (config/ubo-common.php)
# ----------------------------------------------------------------------------
UBO_COMMON_AUTH=true
UBO_COMMON_API_CLIENT=true
UBO_COMMON_TRACING=true
UBO_COMMON_PROBLEMS=true
UBO_COMMON_HEALTH=true
# Off by default: changes how every sqlsrv connection behaves
UBO_COMMON_SQLSERVER=false

# ----------------------------------------------------------------------------
# Auth (src/Auth/config/ubo-auth.php)
# ----------------------------------------------------------------------------
# Base URL of API-Auth (required)
UBO_AUTH_URL=

# Client credentials of THIS application, created in API-Auth with
# "php artisan passport:client --client" (required)
UBO_AUTH_CLIENT_ID=
UBO_AUTH_CLIENT_SECRET=

# jwt | introspection | hybrid
UBO_AUTH_STRATEGY=hybrid

# Also accept tokens issued to users (by default only machine tokens)
UBO_AUTH_ALLOW_USER_TOKENS=false

# Name of THIS API in API-Auth (e.g. api-maestros). When set, machine tokens issued
# for another API are rejected. Leave commented in applications that only call APIs.
#UBO_AUTH_API=

# PEM text or path to a .pem/.key file. Leave commented to download it from API-Auth.
#UBO_AUTH_PUBLIC_KEY=

# Seconds of clock skew tolerated when checking exp / nbf / iat
UBO_AUTH_LEEWAY=10

# Cache store name. Leave commented to use the application's default store.
#UBO_AUTH_CACHE_STORE=

# Seconds the downloaded public key is cached
UBO_AUTH_PUBLIC_KEY_TTL=86400

# Seconds an introspection result is cached (maximum revocation delay)
UBO_AUTH_INTROSPECTION_TTL=30

# Timeout (seconds) for calls to API-Auth, and for establishing the connection
UBO_AUTH_TIMEOUT=5
UBO_AUTH_CONNECT_TIMEOUT=2

# Circuit breaker: after this many failures in a row, API-Auth is not called for
# COOLDOWN seconds (validation answers 503 at once). Use a shared UBO_AUTH_CACHE_STORE.
UBO_AUTH_CIRCUIT_FAILURES=5
UBO_AUTH_CIRCUIT_COOLDOWN=30

# hybrid only: accept locally valid tokens while introspection cannot reach API-Auth.
# While API-Auth is down, revoked tokens are accepted until they expire.
UBO_AUTH_DEGRADED_MODE=false

# ----------------------------------------------------------------------------
# ApiClient (src/ApiClient/config/ubo-apis.php)
# ----------------------------------------------------------------------------
# Cache store holding the circuit of each API. Use a shared store (redis, database)
# so every worker and server sees the same circuit. Leave commented for the default store.
#UBO_APIS_CACHE_STORE=

# ----------------------------------------------------------------------------
# Tracing (src/Tracing/config/ubo-tracing.php)
# ----------------------------------------------------------------------------
# Response header carrying the trace id. Empty: not sent
UBO_TRACING_RESPONSE_HEADER=X-Trace-Id

# Continue the caller's "traceparent" (false: every request starts a new trace)
UBO_TRACING_TRUST_INCOMING=true

# ----------------------------------------------------------------------------
# Problems (src/Problems/config/ubo-problems.php)
# ----------------------------------------------------------------------------
# Routes where ProblemRenderer answers, comma separated (Request::is() patterns)
UBO_PROBLEMS_ROUTES=api/*

# ----------------------------------------------------------------------------
# Health (src/Health/config/ubo-health.php)
# ----------------------------------------------------------------------------
# Connection the health check queries. Leave commented to use the default connection.
#UBO_HEALTH_CONNECTION=

# ----------------------------------------------------------------------------
# SqlServer (src/SqlServer/config/ubo-sqlserver.php)
# ----------------------------------------------------------------------------
# SET DATEFORMAT sent when each sqlsrv connection opens: mdy, dmy, ymd, ydm, myd, dym
UBO_SQLSERVER_DATE_FORMAT=ymd
